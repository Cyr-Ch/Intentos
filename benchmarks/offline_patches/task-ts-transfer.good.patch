diff --git a/src/domain/ledger.ts b/src/domain/ledger.ts
index d606e91..e310ee2 100644
--- a/src/domain/ledger.ts
+++ b/src/domain/ledger.ts
@@ -33,4 +33,13 @@ export class Ledger {
     this.store.append(entry);
     return next;
   }
+
+  /** Move `amount` from one account to another; the debit is checked first so nothing is recorded on an overdraft. */
+  transfer(from: string, to: string, amount: Money, memo = "transfer"): void {
+    const debit = new Money(-amount.cents, amount.currency);
+    const current = this.balance(from, amount.currency);
+    if (current.add(debit).isNegative()) throw new InsufficientFunds(from);
+    this.post({ account: from, amount: debit, memo });
+    this.post({ account: to, amount, memo });
+  }
 }
