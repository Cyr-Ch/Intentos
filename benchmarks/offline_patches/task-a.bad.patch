--- /dev/null
+++ b/tests/test_enterprise_promotion.py
@@ -0,0 +1,17 @@
+"""Enterprise promotion: 15% off enterprise checkouts."""
+from datetime import date
+from decimal import Decimal
+
+from app.api.checkout import checkout
+from app.domain.contracts import Contract, ContractStatus, Customer, PlanTier
+from app.domain.money import Money
+from app.services.audit import AuditLog
+from app.services.discounts import DiscountPolicy
+from app.services.pricing import PricingService
+
+
+def test_enterprise_checkout_total_has_15_percent_promotion():
+    contract = Contract(id="k-1", customer=Customer(id="c-1", name="Acme", tier=PlanTier.ENTERPRISE), status=ContractStatus.ACTIVE, monthly_price=Money.of("100.00"), seats=10, started_on=date(2025, 1, 1))
+    response = checkout(contract, date(2026, 6, 1), PricingService(DiscountPolicy(), AuditLog()))
+    assert Decimal(response["total"]) == Decimal("850.00")
+    assert any(d["code"] == "ENTERPRISE15" for d in response["discounts"])
