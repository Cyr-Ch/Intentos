@@ -0,0 +1,10 @@
+from payments.charge import charge, refund
+
+
+def test_refund_is_negative_charge():
+    assert refund(10) == -1000
+    assert refund(1.25) == -charge(1.25)
+
+
+def test_refund_zero():
+    assert refund(0) == 0