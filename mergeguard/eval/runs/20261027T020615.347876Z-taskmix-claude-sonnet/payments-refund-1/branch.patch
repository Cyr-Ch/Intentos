--- a/payments/charge.py
+++ b/payments/charge.py
@@ -1,3 +1,8 @@
 def charge(amount):
     """Return the captured amount in cents; input is dollars."""
     return round(amount * 100)
+
+
+def refund(amount):
+    """Return the refunded amount in cents (negative); input is dollars."""
+    return -charge(amount)
